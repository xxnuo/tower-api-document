TOWER_CLIENT_ID=your_client_id
TOWER_CLIENT_SECRET=your_client_secret
TOWER_REDIRECT_URI=urn:ietf:wg:oauth:2.0:oob
# 网站公开地址。TOWER_REDIRECT_URI 留空时，使用此地址加 /oauth2/callback。
SITE_BASE_URL=
# MCP 公开基础地址，服务端会追加 /mcp。留空时优先使用 SITE_BASE_URL。
MCP_BASE_URL=
LISTEN_ADDR=[::]:8888
DB_PATH=data/data.db
REGISTRATION_MODE=open
INVITE_CODE=
ALLOW_MCP_DELETE=false
